{
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "product_name", "confidence", "reason"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["search", "addCart", "updateCart", "removeItem", "checkout", "postSales", "faq"]
    },
    "product_name": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string" }
  }
}
