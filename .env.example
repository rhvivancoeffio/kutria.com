# ─── Local docker-compose only (NOT used for Azure SqlServer deploy) ─────────
# ConnectionStrings__Commerce=Host=commerce.db;Port=5432;Database=commerce;Username=commerce;Password=commerce
# ConnectionStrings__Redis=commerce.cache:6379
# ConnectionStrings__RabbitMQ=amqp://guest:guest@commerce.rabbitmq:5672
# ConnectionStrings__Qdrant=http://commerce.qdrant:6334

# ─── Azure provision (make provision-infra) ───────────────────────────────────
SQL_ADMIN_PASSWORD=

# ─── Azure App Settings (make deploy-settings) — Section__Property keys only ──
# With DATABASE_PROVIDER=SqlServer, leave ConnectionStrings__Commerce unset and
# set SQL_ADMIN_PASSWORD — the script builds Server=tcp:sql-kutria-commerce...
# Or set ConnectionStrings__Commerce to a real SqlServer (Server=...) string.
#
# Database__Provider=SqlServer
# Queue__Provider=AzureQueue
# Vector__Provider=AzureSearch
#
# AzureOpenAI__Endpoint=
# AzureOpenAI__ApiKey=
# AzureOpenAI__Deployment=gpt-4o-mini
# AzureOpenAI__EmbeddingDeployment=text-embedding-3-small
#   (alias: AZURE_OPENAI_EMBEDDING_DEPLOYMENT — required for Azure Search index bootstrap)
#
# ConnectionStrings__Redis=
#
# Auth__SigningKey=
# Chat__AllowedOrigins=https://kutria.com,https://www.kutria.com
# Chat__Provider=TableStorage
#
# Speech__Key=
# Speech__Endpoint=https://gravity-builder-product-resource.services.ai.azure.com
# Speech__Region=eastus
#
# AzureSearch__Endpoint=https://search-kutria-commerce.search.windows.net
# AzureSearch__ApiKey=
# AzureSearch__DeleteIndexOnBootstrap=false
# VECTOR_PROVIDER=AzureSearch
#   (local Aspire: make run-apphost loads .env — Vector__Provider=AzureSearch uses cloud Search)
#
# Mcp__PublicBaseUrl=https://mcp.kutria.com
# Mcp__FrontendBaseUrl=https://kutria.com

# ─── Shop SSL (make ssl-shop-letsencrypt) — interactive renew ─────────────────
# LETSENCRYPT_EMAIL=ricardo@kutria.com
# SHOP_SSL_PFX_PASSWORD=
# SHOP_SSL_DOMAIN=kutria.com
